modules = ["nodejs-24", "python-3.12"]

# Autoscale ("cloudrun"): live cursors and observations are persisted in the
# monitor-owned database, and a renewable lease elects one polling worker across
# concurrent instances. Browser sessions never own telemetry progress.
[deployment]
router = "application"
deploymentTarget = "cloudrun"
build = ["bash", "scripts/deploy-build.sh"]
run = ["bash", "scripts/deploy-run.sh"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
