# model-monitoring-prototype environment template. Never commit secrets or
# production customer/employee data. Developer mode remains available locally;
# Replit production must set CONTROL_TOWER_MODE=live through Secrets.

# --- runtime mode and persistence ---
CONTROL_TOWER_MODE=demo
# Required in strict live mode. Use a monitor-owned managed PostgreSQL database;
# never reuse the producer database.
DATABASE_URL=
# SQLite is only the developer/test fallback when DATABASE_URL is blank.
RAI_DB_PATH=

# --- developer-only generated scenario ---
DEMO_SEED=42
RAI_DEFAULT_SCENARIO=DEMO-FULL

# --- monitoring engines ---
ML_MONITOR_ADAPTER=evidently_nannyml
EXPLAIN_ADAPTER=lime_shap

# --- live producer contract ---
LIVE_CHURN_URL=http://127.0.0.1:8083
LIVE_CHATBOT_URL=http://127.0.0.1:8082
LIVE_NBA_URL=http://127.0.0.1:8084
LIVE_PRODUCER_URL=
LIVE_TELEMETRY_TOKEN=
# Separate bearer token used only by the scheduled POST /api/live/poll wake request.
LIVE_WORKER_TOKEN=
LIVE_POLL_SECONDS=5
LIVE_POLL_LEASE_SECONDS=30
LIVE_IDLE_SECONDS=30
LIVE_STALE_SECONDS=120
LIVE_HIST_MAX=240

# --- real LLM judge ---
# Strict live mode requires this key and never falls back to heuristic scores.
ANTHROPIC_API_KEY=
LLM_JUDGE_MODEL=claude-haiku-4-5
LLM_JUDGE_MAX_TRACES=20

# --- Langfuse score write-back ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Set only by automated tests that intentionally exercise strict-live validation
# without external services. Never set this in Replit production.
ALLOW_INSECURE_LIVE_TESTING=0
