# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
.venv-backend/
.venv-test/
backend/.venv/
backend/control_tower.db
backend/.build-sha
backend/artifacts/*
!backend/artifacts/.gitkeep
__pycache__/
*.pyc

# legacy Next.js frontend — superseded by the React/Vite artifacts/control-tower app
# (its canonical copy is archived under .migration-backup/frontend/). Kept on disk but
# not tracked: it is not a pnpm workspace package and carries only build cruft.
/frontend/

# --- env / secrets (NEVER commit real keys) ---
.env
.env.*
!.env.example
